# docs/PRD-instagram-smart-dm-and-ir-intl-split.md بخش ۳.۱ — ایمیج جدای دیپلوی INTL
# (nivoai.site، همروش/Darkube، اپ جدا از front-end ایرانی). همان الگوی Dockerfile.prod IR،
# با VITE_REGION=INTL (entry/main/router جداگانه‌ی مینی‌پنل — بدون چت/تصویر/ویدیو/نیوو کال/
# Orders/Products) و envهای دیگری (بدون Enamad/تلگرام/پیامک که اصلاً برای INTL معنا ندارند)

# ─── مرحله build ────────────────────────────────────────────
FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

# مثل Dockerfile.prod IR: دارکوب مقدار پنل «Environment Variables» را به این build-arg ها
# نمی‌رساند (تست‌شده روی IR) — پس مقدار واقعی دیپلوی آلمان همین‌جا ست می‌شود، نه یک
# پیش‌فرض override-پذیر. برای عوض‌کردن، همین‌جا ویرایش کن.
ARG VITE_API_URL=https://api.nivoai.site/api/v1
ENV VITE_REGION=INTL
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build:intl
# vite با entry سفارشی، HTML خروجی را با همون نام (index.intl.html) در dist/ می‌گذارد؛
# nginx.intl.conf انتظار index.html را دارد — به‌جای نگه‌داشتن یک nginx.conf دوم فقط برای
# تغییر نام فایل، همین‌جا یکی می‌شوند
RUN mv dist/index.intl.html dist/index.html

# ─── مرحله serve ────────────────────────────────────────────
FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.intl.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
